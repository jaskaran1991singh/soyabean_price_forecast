# Copy this file to .env and fill in your keys. Never commit .env.
# .env is read automatically by config.load_settings() (python-dotenv).

# Tavily search — required by the research agent (`python -m soyfc agent`).
# Free key: https://app.tavily.com
TAVILY_API_KEY=

# Google Gemini — required by the research agent (model id in config/settings.yaml: agent.model).
# Free key: https://aistudio.google.com -> Get API key
GOOGLE_API_KEY=

# data.gov.in — optional, only for the `datagov` mandi source (see settings.yaml: mandi_sources).
# The default mandi source (mandi_api) and all other collectors need no key.
DATA_GOV_IN_API_KEY=
